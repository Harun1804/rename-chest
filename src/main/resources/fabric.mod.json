{
	"schemaVersion": 1,
	"id": "chest-rename",
	"version": "${version}",
	"name": "Chest Rename",
	"description": "Rename chests and show their names when you look at them.",
	"license": "CC0-1.0",
	"icon": "assets/chest-rename/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.harun.ChestRename",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.harun.ChestRenameClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.harun.ChestRenameDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}